;; groundwork-postgres: Postgres from Clojure. Every query a .sql file; tables declared as
;; maps, and Postgres brought to what they say. One tree: source-code/groundwork_postgres/.
{:paths ["source-code"]

 :deps
 {com.github.seancorfield/next.jdbc {:mvn/version "1.4.70"}
  org.postgresql/postgresql         {:mvn/version "42.7.14"}
  com.zaxxer/HikariCP               {:mvn/version "7.1.0"}
  ;; HikariCP writes through SLF4J: this hands its lines to java.util.logging,
  ;; where groundwork-postgres sends them to the pool's log (groundwork-postgres.queries.pool-lines)
  org.slf4j/slf4j-jdk14             {:mvn/version "2.0.20"}
  ;; the app's meter, handed in: the pool's metrics and every query's time
  io.github.p4ulcristian/groundwork-metrics      {:git/tag "v0.1.6" :git/sha "88ae7a3"}
  ;; the password, a secret that prints as its name: revealed only for the driver
  io.github.p4ulcristian/groundwork-settings       {:git/tag "v0.1.3" :git/sha "d277ab0"}
  ;; jsonb columns and Postgres's query plans
  metosin/jsonista                  {:mvn/version "1.0.2"}
  ;; the settings, options and table maps, checked before anything runs
  metosin/malli                     {:mvn/version "0.20.3"}}

 :aliases
 {;; the tests:  clojure -X:test  (the Postgres ones need POSTGRES_TEST_PORT, see README.md)
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; the row shapes groundwork-postgres makes, read by the edge that checks them
                       io.github.p4ulcristian/groundwork-shaped-json          {:git/tag "v0.2.2" :git/sha "1c0fcf9"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
